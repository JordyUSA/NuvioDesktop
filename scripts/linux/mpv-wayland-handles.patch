@@ -1432,6 +1432,19 @@ static int mp_property_window_id(void *ctx, struct m_property *prop,
     return m_property_int64_ro(action, arg, wid);
 }
 
+static int mp_property_wayland_handle(void *ctx, struct m_property *prop,
+                                      int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    struct vo *vo = mpctx->video_out;
+    void *handle = NULL;
+    int request = strcmp(prop->name, "wayland-display") == 0
+                  ? VOCTRL_GET_WAYLAND_DISPLAY : VOCTRL_GET_WAYLAND_SURFACE;
+    if (!vo || vo_control(vo, request, &handle) <= 0 || !handle)
+        return M_PROPERTY_UNAVAILABLE;
+    return m_property_int64_ro(action, arg, (intptr_t)handle);
+}
